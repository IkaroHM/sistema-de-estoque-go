    {
      "id": "8esp_LLWtBKPzA7RtKYFg",
      "type": "text",
      "x": 5596.208337786102,
      "y": 9304.661599910181,
      "width": 1081.9753086419732,
      "height": 608.6111111111098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "U3m9HGCwxpMZzpRiqUbT0",
      "index": "b14G",
      "roundness": null,
      "seed": 366114303,
      "version": 965,
      "versionNonce": 1945822361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790971449205,
      "created": 1790882435478,
      "link": null,
      "locked": false,
      "text": "Sera a abstracao/camada de movimentacao.\nEla sera responsável pela venda, compra, ou\nqualquer coisa que envolva dinheiro.\nEla atuará sobre os metodos padroes de um\nProduto. Porém, os metodos de GetAll,\nGetById e etc(que nao envolvem dinheiro)\nnao serao usados. Será feito dessa maneira,\npois deixa tudo preparado para futuras\natualizacoes e integracoes com outros\npacotes internos ou externos",
      "fontSize": 48.68888888888879,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sera a abstracao/camada de movimentacao.\nEla sera responsável pela venda, compra, ou qualquer coisa que envolva dinheiro.\nEla atuará sobre os metodos padroes de um Produto. Porém, os metodos de GetAll, GetById e etc(que nao envolvem dinheiro)  nao serao usados. Será feito dessa maneira, pois deixa tudo preparado para futuras atualizacoes e integracoes com outros pacotes internos ou externos",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
